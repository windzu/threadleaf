{
  "compilerOptions": {
    "skipLibCheck": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strict": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["DOM", "ES2022"],
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["src/**/*.ts"]
}
